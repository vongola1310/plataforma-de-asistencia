# Neon Postgres
# DATABASE_URL: connection string PUNTO POOLED (host con "-pooler"), usada en runtime por la app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL: conexión DIRECTA (sin pooler), usada solo por el CLI de Prisma para migraciones.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js (admin panel)
AUTH_SECRET="" # generar con: openssl rand -base64 32

# Resend
RESEND_API_KEY=""
EMAIL_FROM="Showroom <notificaciones@tudominio.com>"

# Cron de recordatorios
CRON_SECRET="" # generar con: openssl rand -hex 32

# Vercel Blob (croquis)
BLOB_READ_WRITE_TOKEN=""

# Base URL pública, usada para construir links en emails (ej. https://showroom.tudominio.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
