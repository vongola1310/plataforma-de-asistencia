# ---------------------------------------------------------------------------
# Neon Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL: conexión POOLED (el host lleva "-pooler"), la que usa la app en
# tiempo de ejecución.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL: conexión DIRECTA (sin pooler), usada solo por el CLI de Prisma
# para las migraciones.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (panel de administración)
# ---------------------------------------------------------------------------
AUTH_SECRET="" # generar con: openssl rand -base64 32
# Solo si despliegas FUERA de Vercel (self-hosting, Docker, `next start` local):
# Auth.js rechaza el login con "UntrustedHost" si no confía en el host. En
# Vercel se detecta solo y no hace falta ponerla.
# AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Admin inicial (solo lo lee `prisma db seed`, no la app)
# ---------------------------------------------------------------------------
# En producción el seed falla si no defines SEED_ADMIN_PASSWORD, para no crear
# un administrador con una contraseña conocida.
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD="" # generar con: openssl rand -base64 24
SEED_ADMIN_NAME="Administrador"

# ---------------------------------------------------------------------------
# Resend (correos)
# ---------------------------------------------------------------------------
# Opcional: sin esto la app funciona, pero no envía ningún correo y el asistente
# solo recibe su link de acceso en pantalla.
RESEND_API_KEY=""
EMAIL_FROM="Showroom <notificaciones@tudominio.com>"

# ---------------------------------------------------------------------------
# Cron de recordatorios
# ---------------------------------------------------------------------------
CRON_SECRET="" # generar con: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Vercel Blob (croquis)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Dominio público
# ---------------------------------------------------------------------------
# Se usa para construir los links personales de acceso que van en los correos.
# NO le pongas el prefijo NEXT_PUBLIC_: esas variables se congelan durante el
# build y los links quedarían apuntando a localhost hasta el siguiente deploy.
# Si la dejas vacía, la app usa el dominio del propio request, así que en
# desarrollo no necesitas configurarla.
APP_URL="https://showroom.tudominio.com"
